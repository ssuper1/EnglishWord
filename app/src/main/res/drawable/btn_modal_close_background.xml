<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/wm_form_bg" />
            <stroke android:width="1dp" android:color="#C0BBB5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/wm_card" />
            <stroke android:width="1dp" android:color="@color/wm_border" />
        </shape>
    </item>
</selector>
