<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/form_tag_background"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDictName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IELTS 核心词汇"
            android:textSize="15sp"
            android:textColor="@color/wm_text"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDictInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6515 词"
            android:textSize="13sp"
            android:textColor="@color/wm_text_tertiary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textSize="20sp"
        android:textColor="@color/wm_accent_word"
        android:visibility="gone"
        android:layout_marginStart="12dp" />

</LinearLayout>
